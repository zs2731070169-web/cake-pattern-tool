# pattern-tool 环境变量模板
# 复制为 .env 使用（.env 已进 .gitignore，绝不入库）
# 优先级：真实环境变量 > .env > config.py 字段默认值
# 生产由 systemd EnvironmentFile= 指向同构文件注入

# ---- 服务 ----
# 监听端口（uvicorn :8200）
PT_PORT=8200
# 数据库与图片根目录（批次文件落 {data_dir}/jobs/{job_id}/）
PT_DATA_DIR=data

# ---- 上传校验 ----
# 单批图片张数上限（1-9）
PT_MAX_IMAGES_PER_JOB=9
# 单张图片字节上限（15MB）
PT_MAX_IMAGE_BYTES=15728640
# 单张图片字节下限（1KB，拦空文件/残片；"过小"拦截主要由像素下限负责）
PT_MIN_IMAGE_BYTES=1024
# 解码后单边像素上限（3600px）
PT_MAX_IMAGE_PIXELS=3600
# 解码后单边像素下限（60px 拦图标/碎片；小图上传是用户意志，low-res 提示兜底）
PT_MIN_IMAGE_PIXELS=60
# 同批内容查重（SHA-256 重复即 422）
PT_REJECT_DUPLICATE_IMAGES=true

# ---- 限流 ----
# 同 IP 进行中批次上限（超限 429；2026-08-26 3→9：同用户多任务并行不排队）
PT_MAX_CONCURRENT_JOBS_PER_IP=9

# ---- 管线 ----
# 单图处理时长上限（秒，只计 processing 段；去水印生成式 40s + 换底生成式 40s + 描边 ~10s 最坏和）
PT_IMAGE_PROCESS_TIMEOUT_SECONDS=180
# 排队时长上限（秒，超时置 failed 提示错峰）
PT_IMAGE_QUEUE_TIMEOUT_SECONDS=600
# 同时 processing 图数上限（0 = 自动取 2×CPU 核数）
PT_MAX_CONCURRENT_PROCESSING=0
# 启用的管线步骤（逗号分隔；单步调试可只留 watermark——未列步骤按 skipped 记档不执行）
# fill 的生成式路径需配 PT_FILL_GEN_*；未配 key 时非白背景图按原图零误伤跳过
PT_STEPS_ENABLED=watermark,fill,crop,outline,resize

# ---- TTL ----
# 批次保留时长（小时，过期清理文件与记录）
PT_JOB_TTL_HOURS=24
# 清理器扫描间隔（小时）
PT_TTL_SCAN_INTERVAL_HOURS=1

# ---- 描边步（图像处理方案 3.5：1-2mm 浅灰线，MVP 定 1.5mm）----
# 描边线宽（毫米）
PT_OUTLINE_WIDTH_MM=1.5
# 描边灰线明度（RGB 190,190,190）
PT_OUTLINE_GRAY_LEVEL=190
# 打印 DPI 基准（12 寸 290mm@300DPI，low-res 判定与 mm→px 换算依据）
PT_PRINT_DPI=300
# 图案分割用 rembg alpha 蒙版（不可用自动回退灰度阈值法）
PT_OUTLINE_MATTING_ENABLED=true
# rembg 模型名（u2netp 4.5MB 轻量；效果不足可换 u2net / isnet-general-use）
PT_OUTLINE_MATTING_MODEL=u2netp
# alpha 二值化阈值（≥ 此值为图案）
PT_OUTLINE_MATTING_ALPHA_THRESHOLD=128

# ---- 填充步（v17：isnet 分割与拓扑填白已退役，本地仅剩 Path A 透明合成）----
# （旧键 PT_FILL_MATTING_MODEL / PT_FILL_BLANK_RATIO_THRESHOLD /
#   PT_FILL_BACKGROUND_VARIANCE_THRESHOLD 已移除，残留配置会被忽略）

# ---- 填充步 Path C：qwen-image-2.0 生成式换白底（v16，假 alpha/彩色照片背景）----
# 是否启用（需同时把 fill 加入 PT_STEPS_ENABLED；未配置 key 时非白背景图按原图零误伤跳过）
PT_FILL_GEN_ENABLED=false
# 阿里云百炼 DashScope API Key（qwen-image-2.0 按成功生成张数计费，结果缓存防同图重复计费；绝不入库、不进前端/日志/错误信息）
PT_FILL_GEN_KEY=
# 模型名（qwen-image-2.0 加速版；精细度不足可换 qwen-image-2.0-pro）
PT_FILL_GEN_MODEL=qwen-image-2.0
# 生成+下载等待上限（秒；超时快速降级本地路径不拖垮全图）
PT_FILL_GEN_TIMEOUT_SECONDS=40
# 触发门：形状边界带"宽白系以外"占比阈值（≥ 此值判背景本地填不了才外呼；白/米/淡彩底不外呼）
PT_FILL_GEN_TRIGGER_RATIO=0.5

# （OpenCV 水印检测已退役——qwen-vl 唯一检测器；旧 PT_WM_SIMPLE/RATIO 等键残留会被忽略）

# ---- 去水印修复：佐糖 PicWish 高级版 API（2026-08-26 回退恢复主力）----
PT_WM_API_ENABLED=false
PT_WM_API_KEY=
# 佐糖等待上限（秒，同步等待至完成；慢图实测 ~56s+）
PT_WM_API_TIMEOUT_SECONDS=110

# ---- 去水印段 2：qwen-vl 语义预检（4.4 v3 三段链路）----
# 每图 VL 预检判水印（~¥0.003/次；判有才调 qwen-image 修复）
PT_WM_PRECHECK_ENABLED=false
# 阿里云百炼 DashScope API Key（qwen-vl-plus 文本计费）
PT_WM_PRECHECK_KEY=
# VL 模型名（默认 qwen-vl-plus；更换模型只改此变量）
PT_WM_PRECHECK_MODEL=qwen-vl-plus
