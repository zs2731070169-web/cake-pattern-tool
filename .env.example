# pattern-tool 环境变量模板
# 复制为 .env 使用（.env 已进 .gitignore，绝不入库）
# 优先级：真实环境变量 > .env > config.py 字段默认值
# 生产由 systemd EnvironmentFile= 指向同构文件注入

# ---- 服务 ----
# 监听端口（uvicorn :8200）
PT_PORT=8200
# 数据库与图片根目录（批次文件落 {data_dir}/jobs/{job_id}/）
PT_DATA_DIR=data
# 控制台日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
PT_LOG_LEVEL=INFO
# 文件日志级别（{data_dir}/logs/app.log 持久化通道，10MB×5 轮转；排障主径全量落盘）
PT_LOG_FILE_LEVEL=DEBUG

# ---- 上传校验 ----
# 单批图片张数上限（1-9）
PT_MAX_IMAGES_PER_JOB=9
# 单张图片字节上限（15MB）
PT_MAX_IMAGE_BYTES=15728640
# 单张图片字节下限（1KB，拦空文件/残片；"过小"拦截主要由像素下限负责）
PT_MIN_IMAGE_BYTES=1024
# 解码后单边像素上限（3600px）
PT_MAX_IMAGE_PIXELS=3600
# 解码后单边像素下限（60px 拦图标/碎片；小图上传是用户意志，low-res 提示兜底）
PT_MIN_IMAGE_PIXELS=60
# 同批内容查重（SHA-256 重复即 422）
PT_REJECT_DUPLICATE_IMAGES=true

# ---- 限流 ----
# 同 IP 进行中批次上限（超限 429；2026-08-26 3→9：同用户多任务并行不排队）
PT_MAX_CONCURRENT_JOBS_PER_IP=9

# ---- 管线 ----
# 单图处理时长上限（秒，只计 processing 段；去水印生成式 40s + 换底生成式 40s + 描边 ~10s 最坏和）
PT_IMAGE_PROCESS_TIMEOUT_SECONDS=180
# 排队时长上限（秒，超时置 failed 提示错峰；第二十六次修订：投递时刻起算，不再阻塞等位）
PT_IMAGE_QUEUE_TIMEOUT_SECONDS=600
# 同时 processing 图数上限 = executor 线程数（0 = 自动取 2×CPU 核数）。
# 批内并行（第二十六次修订）：外呼等待占 85%，IO 密集可调大（如 9 图批设 9 全并行）
PT_MAX_CONCURRENT_PROCESSING=0
# ---- 裁剪步（2026-08-28 第二十次修订：五步各配独立开关）----
# 是否执行声明式裁剪（关 = 不裁框不塑形原图直通，skipped 记档）
PT_CROP_ENABLED=true

# ---- TTL ----
# 批次保留时长（小时，过期清理文件与记录）
PT_JOB_TTL_HOURS=24
# 清理器扫描间隔（小时）
PT_TTL_SCAN_INTERVAL_HOURS=1

# ---- 描边步（图像处理方案 3.5：1-2mm 浅灰线，MVP 定 1.5mm）----
# 描边线宽（毫米；前端"统一线宽"选"默认"时的取值——批级声明 1–2mm 可逐批覆盖，第三十四次修订）
PT_OUTLINE_WIDTH_MM=1.0
# 描边灰线明度（RGB 190,190,190）
PT_OUTLINE_GRAY_LEVEL=210
# 打印 DPI 基准（mm→px 换算依据）
PT_PRINT_DPI=300
# 图案分割用 rembg alpha 蒙版（不可用自动回退灰度阈值法）
PT_OUTLINE_MATTING_ENABLED=true
# rembg 模型名（u2netp 4.5MB 轻量；效果不足可换 u2net / isnet-general-use）
PT_OUTLINE_MATTING_MODEL=u2netp
# alpha 二值化阈值（≥ 此值为图案）
PT_OUTLINE_MATTING_ALPHA_THRESHOLD=128

# ---- 填充步 Path C：qwen-image-2.0 生成式换白底（v16，假 alpha/彩色照片背景）----
# 是否启用（需同时配 key；未配置 key 时非白背景图按原图零误伤跳过）
PT_FILL_GEN_ENABLED=false
# 阿里云百炼 DashScope API Key（按成功生成张数计费，结果缓存防同图重复计费）
PT_FILL_GEN_KEY=
# 模型名（qwen-image-2.0 加速版）
PT_FILL_GEN_MODEL=qwen-image-2.0
# 生成+下载等待上限（秒）
PT_FILL_GEN_TIMEOUT_SECONDS=40
# 触发门阈值
PT_FILL_GEN_TRIGGER_RATIO=0.5

# ---- 去水印修复：石榴智能高级版唯一供应商 ----
# 是否启用修复外呼（关 = 检出也不修，skipped 原图）
PT_WM_API_ENABLED=false
# 石榴智能 APIKEY
PT_SHILIU_API_KEY=
# 石榴异步预算（秒）
PT_SHILIU_TIMEOUT_SECONDS=60

# ---- 超分放大：佐糖 scale-pro 高级变清晰主力 ----
# 是否启用超分外呼（关 = 放大记 failed 不交付）
PT_SCALE_ENABLED=false
# 佐糖 X-API-KEY
PT_PICWISH_API_KEY=
# 佐糖任务等待上限（秒）
PT_PICWISH_TIMEOUT_SECONDS=110

# ---- 第三方 API 并发闸（批内并行外呼限流，任务周期粒度排队；0=不限）----
# 佐糖超分在途任务上限（9 图批实测 3 并发成功、第 4 个起 429）
PT_PICWISH_MAX_CONCURRENT=3
# 百炼并发上限（入口双 VL + 水印预检 + qwen-image 填充共用）
PT_DASHSCOPE_MAX_CONCURRENT=4
# 石榴去水印在途任务上限
PT_SHILIU_MAX_CONCURRENT=2

# ---- 去水印段 2：qwen-vl 语义预检 ----
PT_WM_PRECHECK_ENABLED=false
# DashScope API Key
PT_WM_PRECHECK_KEY=
# VL 模型名
PT_WM_PRECHECK_MODEL=qwen-vl-plus
